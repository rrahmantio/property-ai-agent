# Copy this to .env and fill in real values. Never commit .env.

# LLM
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Threads (Meta Graph API) — long-lived user token + your Threads user id
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Property requirement form
TYPEFORM_URL=https://form.typeform.com/to/TJfuvi6E

# Email approval workflow (Gmail example — use an app password, not your real password)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_TO=

# Approval webhook (approval_app.py) — deploy it, then set this to its public URL
APPROVAL_SECRET=
APPROVAL_BASE_URL=http://localhost:8080

# Storage
DB_PATH=data/hoz_agent.db
